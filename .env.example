# UPDOWN Topologia NOC
PORT=3000
NODE_ENV=production
SESSION_HOURS=12
APP_TIMEZONE=America/Sao_Paulo

# Turso (no Worker, cadastre ambos como Secrets em Variables and Secrets)
TURSO_DATABASE_URL=libsql://SEU_BANCO-SUA_ORGANIZACAO.turso.io
TURSO_AUTH_TOKEN=SEU_TOKEN_TURSO

# OAuth 2.0 / OpenID Connect (Authorization Code + PKCE)
# O issuer e o client ID não são secretos. No Worker, configure-os como vars.
OAUTH_ISSUER=https://login.exemplo.com/tenant/v2.0
OAUTH_CLIENT_ID=SEU_CLIENT_ID
OAUTH_SCOPES=openid profile email
OAUTH_BUTTON_LABEL=Entrar com conta corporativa
OAUTH_ALLOWED_DOMAINS=updown.com.br
# Vincula no primeiro acesso o preferred_username do provedor a uma conta local
# já existente. Use somente com um issuer corporativo confiável e domínio restrito.
OAUTH_ALLOW_USERNAME_LINK=false
OAUTH_AUTO_PROVISION=false
OAUTH_DEFAULT_ROLE=atendimento
PASSWORD_LOGIN_ENABLED=true

# Secrets (nunca colocar no wrangler.jsonc ou versionar em .dev.vars):
#   npx wrangler secret put OAUTH_CLIENT_SECRET
#   npx wrangler secret put BOOTSTRAP_ADMIN_PASSWORD
#   npx wrangler secret put DEVICE_CREDENTIALS_KEY
# DEVICE_CREDENTIALS_KEY deve ser aleatoria, ter pelo menos 32 caracteres e
# permanecer a mesma para que as senhas dos aparelhos continuem decifraveis.
# BOOTSTRAP_ADMIN_PASSWORD só é usado se ainda não existir o usuário de bootstrap.
BOOTSTRAP_ADMIN_USERNAME=admin

# Zabbix
# No Worker (Cloudflare) estes valores são Secrets, não variáveis do wrangler.jsonc:
#   npx wrangler secret put ZABBIX_URL
#   npx wrangler secret put ZABBIX_TOKEN
# Em desenvolvimento local o wrangler lê o arquivo .dev.vars (fora do git).
ZABBIX_URL=https://SEU-ZABBIX/api_jsonrpc.php
ZABBIX_TOKEN=COLE_SEU_TOKEN_AQUI

# Adaptador HTTP da OLT/ACS/NMS. Deve devolver clientes/ONUs autenticados e,
# quando disponíveis, caixas, localização e caminho do drop. Configure como Secrets:
#   npx wrangler secret put GPON_CLIENTS_URL
#   npx wrangler secret put GPON_CLIENTS_TOKEN
GPON_CLIENTS_URL=https://SEU-COLETOR-INTERNO/api/gpon/clientes
