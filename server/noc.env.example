# Vira /etc/noc.env no servidor (chmod 600). Um par NOME=valor por linha,
# sem aspas e sem "export".

# --- Banco (obrigatorio) ---
# O sqld roda no mesmo servidor, so escuta em 127.0.0.1 e nao valida token,
# mas turso-d1.js exige a variavel preenchida.
TURSO_DATABASE_URL=http://127.0.0.1:8080
TURSO_AUTH_TOKEN=local

# --- Aplicacao ---
PORT=8787
PASSWORD_LOGIN_ENABLED=true
DEVICE_CREDENTIALS_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- OAuth (o redirect_uri muda para o dominio novo) ---
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://sistema.updown.com.br/api/auth/oauth/callback
OAUTH_ALLOWED_DOMAINS=updown.com.br
OAUTH_ALLOW_USERNAME_LINK=false
OAUTH_AUTO_PROVISION=false

# --- Zabbix ---
ZABBIX_URL=
ZABBIX_TOKEN=

# --- GPON / coletor ---
GPON_CLIENTS_URL=
GPON_CLIENTS_TOKEN=
GPON_SYNC_TOKEN=
PROVISIONING_TOKEN=

# --- WhatsApp / Opa!Suite ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OPASUITE_API_BASE=
OPASUITE_API_TOKEN=
OPASUITE_WEBHOOK_SECRET=

# --- Anexos e audios do chat ---
# Pasta dos arquivos enviados e recebidos no chat. Sem a variavel, usa
# data/media dentro de /opt/noc (ignorada pelo git). Fora do clone e melhor:
# sobrevive a um re-clone do repositorio.
MEDIA_DIR=/var/lib/noc/media

# --- App do Assinante UpDown (canal updown_app no chat) ---
# Onde a API do app escuta (mesma máquina) e o segredo compartilhado — o mesmo
# NOC_SEGREDO do api.env do app. Gere com: openssl rand -hex 32
UPDOWN_APP_URL=http://127.0.0.1:3000
UPDOWN_APP_SEGREDO=
