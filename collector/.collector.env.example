# O coletor deve rodar em uma máquina conectada à rede/VPN das OLTs.
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8790
COLLECTOR_TOKEN=gere-um-token-longo-e-aleatorio

# Ciclo rápido: estado das ONUs na OLT e autenticação no Radius do IXC.
# Os dois correm em paralelo e cada um pula a vez enquanto o anterior não
# terminou, então este valor é o piso do intervalo, não uma promessa: se o
# "show gpon onu state" da OLT levar 25 s, o ciclo dela passa a ser de 25 s.
COLLECTOR_INTERVAL_MS=10000

# Ciclo completo: cadastro do IXC (clientes, contratos, caixas) e baseinfo das
# PONs. Custa caro e muda pouco.
IXC_REFRESH_INTERVAL_MS=600000

# Leitura rápida direto na OLT. Desligue (0) se o parque for grande demais
# para consultar o equipamento de produção a cada 10 s — o estado continua
# vindo do Radius do IXC no ciclo rápido e da OLT no ciclo completo.
ONT_FAST_ENABLED=1

ZTE_C350_ID=olt-c350
ZTE_C350_NAME=ZTE C350
ZTE_C350_HOST=172.16.255.1
ZTE_C350_PORT=22
ZTE_C350_PROTOCOL=ssh
ZTE_C350_USERNAME=usuario-somente-leitura
ZTE_C350_PASSWORD=senha-local-nao-versionada

ZTE_C300_ID=olt-c300
ZTE_C300_NAME=ZTE C300
ZTE_C300_HOST=172.16.21.14
ZTE_C300_PORT=23
ZTE_C300_PROTOCOL=telnet
ZTE_C300_USERNAME=usuario-somente-leitura
ZTE_C300_PASSWORD=senha-local-nao-versionada

# Provisionamento de usuários nos aparelhos (SSH/Telnet), criado no cadastro
# do usuário na plataforma. O coletor busca os jobs no Worker, conecta no
# aparelho com a credencial de administração do destino e cria a conta.
# Sem PROVISIONING_PUSH_URL o recurso fica desligado (herda a base do GPON_PUSH_URL).
#
# Tráfego e conexão saem da mesma leitura de `radusuarios` que já traz o estado
# do Radius, então não há intervalo próprio para configurar. As colunas são
# lidas com tolerância de nome (velocidade_download / velocidade_down /
# download, e assim por diante): uma base que não preencha alguma delas mostra
# o campo vazio na tela, sem quebrar o ciclo.
PROVISIONING_PUSH_URL=https://topologia-noc.exemplo.workers.dev
PROVISIONING_PUSH_TOKEN=mesmo-token-do-gpon-push-ou-um-dedicado
PROVISIONING_INTERVAL_MS=30000
