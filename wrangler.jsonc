{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "bd",
      "database_name": "topologia-noc",
      "database_id": "b2559011-42bd-49d0-a22b-5c22efce1913"
    }
  ]
}
