{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "GPON_SYNC_TOKEN"
    ]
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // R2 desabilitado nesta conta: sem binding MEDIA, upload de imagem no chat
  // responde MEDIA_NAO_CONFIGURADO em vez de quebrar o deploy (ver
  // storeMediaUpload/handleMediaGet em worker.js, ambos já toleram
  // env.MEDIA ausente). Pra reativar: criar o bucket
  // (`npx wrangler r2 bucket create topologia-noc-media`) e devolver o
  // bloco abaixo:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "topologia-noc-media" }],
  //
  // Sincronização automática do Zabbix a cada 5 minutos: é o que mantém o
  // painel de tráfego e o histórico atualizados sozinhos no telão do NOC.
  // Secrets do Chat WhatsApp (ver .env.example):
  //   WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
  //   WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
  //   OPASUITE_API_TOKEN, OPASUITE_WEBHOOK_SECRET (canais externos: Meta via
  //   Opa!Suite e Webchat do Opa!Suite, mesma fila)
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
