{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "GPON_SYNC_TOKEN"
    ]
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Imagens trocadas no chat (app cliente e staff): bucket precisa existir
  // antes do deploy — `npx wrangler r2 bucket create topologia-noc-media`.
  // Sem binding público: as imagens só são lidas via GET /api/media/:key,
  // que exige sessão (ver handleMediaGet em worker.js).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "topologia-noc-media"
    }
  ],
  // Sincronização automática do Zabbix a cada 5 minutos: é o que mantém o
  // painel de tráfego e o histórico atualizados sozinhos no telão do NOC.
  // Secrets do Chat WhatsApp (ver .env.example):
  //   WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
  //   WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
  //   OPASUITE_API_TOKEN, OPASUITE_WEBHOOK_SECRET (canais externos: Meta via
  //   Opa!Suite e Webchat do Opa!Suite, mesma fila)
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
