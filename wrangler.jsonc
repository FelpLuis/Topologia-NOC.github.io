{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN"]
  },
  "placement": {
    "mode": "targeted",
    "region": "aws:us-east-1"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // Sincronização automática do Zabbix a cada 5 minutos: é o que mantém o
  // painel de tráfego e o histórico atualizados sozinhos no telão do NOC.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
