{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
