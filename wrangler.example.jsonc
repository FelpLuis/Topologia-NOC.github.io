{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "topologia-noc",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Sincronização automática do Zabbix: alimenta o painel de tráfego e o
  // histórico agregado sem depender de alguém clicar em "Sincronizar agora".
  // Só roda quando ZABBIX_URL e ZABBIX_TOKEN estão configurados.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Zabbix: ZABBIX_URL e ZABBIX_TOKEN são Secrets, não vars.
    //   npx wrangler secret put ZABBIX_URL
    //   npx wrangler secret put ZABBIX_TOKEN
    "OAUTH_ISSUER": "https://login.exemplo.com/tenant/v2.0",
    "OAUTH_CLIENT_ID": "SEU_CLIENT_ID",
    "OAUTH_ALLOWED_DOMAINS": "updown.com.br",
    "OAUTH_ALLOW_USERNAME_LINK": "false",
    "OAUTH_AUTO_PROVISION": "false",
    "PASSWORD_LOGIN_ENABLED": "true"
  }
}
